FROM golang:1.26.5-alpine AS golang_builder

WORKDIR /build

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /build/openftv ./external/gateways/kong/plugins/openftv/cmd/

# Stage 2 - run
FROM alpine:latest

COPY --from=golang_builder /build/openftv /usr/local/bin

ENTRYPOINT ["/usr/local/bin/openftv"]
