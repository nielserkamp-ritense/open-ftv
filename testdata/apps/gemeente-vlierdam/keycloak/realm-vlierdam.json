{
  "realm": "vlierdam",
  "enabled": true,
  "roles": {
    "realm": [
      { "name": "ambtenaar" },
      { "name": "gemeentesecretaris" }
    ]
  },
  "clients": [
    {
      "clientId": "laadpalen-applicatie",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": false,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        },
        {
          "name": "laadpalen-applicatie-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "laadpalen-applicatie",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
