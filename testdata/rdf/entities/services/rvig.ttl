@prefix : <http://example.com/rvig/rdf/services#> .

@prefix ftv: <https://ftv.nl/rdf/ftv#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.com/rvig/rdf/services>
    a ftv:Collection ;
    skos:prefLabel "RvIG service entities"@en ;
    skos:prefLabel "RvIG service entiteiten"@nl  ;
    dcterms:title "List of service entities van RvIG"@en ;
    dcterms:title "Lijst van service entiteiten"@nl ;
.

:personen
    a ftv:Entity ;
    skos:prefLabel "Persons API"@en ;
    skos:prefLabel "Personen API"@nl  ;
    dcterms:title "API to retrieve details of one or more persons"@en ;
    dcterms:title "API voor het ophalen van persoonsgegevens"@nl ;
    ftv:type "service" ;
    ftv:id "https://inway-fsc-nlx-inway:443/brp-personen" ;
    ftv:attribute
            [
                ftv:key "owner" ;
                ftv:value "RvIG" ;
            ] ,
            [
                ftv:key "code" ;
                ftv:value "BRP" ;
            ] ,
            [
                ftv:key "name" ;
                ftv:value "Basis Registratie Personen" ;
            ] ,
            [
                ftv:key "queryFields" ;
                ftv:value :parameterType , :parameterFields, :parameterBSN ;
            ] ;
.

:parameterType
    a rdf:Property ;
    skos:prefLabel "Persons API type parameter"@en ;
    skos:prefLabel "Personen API type parameter"@nl  ;
    dcterms:title "The type of query to be performed"@en ;
    dcterms:title "Het type zoekopdracht die uitgevoerd moet worden"@nl ;
    rdf:type xsd:string ;
    ftv:key "type" ;
    ftv:value
            "ZoekMetGeslachtsnaamEnGeboortedatum" ,
            "ZoekMetNaamEnGemeenteVanInschrijving" ,
            "RaadpleegMetBurgerservicenummer" ,
            "ZoekMetPostcodeEnHuisnummer" ,
            "ZoekMetStraatHuisnummerEnGemeenteVanInschrijving" ,
            "ZoekMetNummeraanduidingidentificatie" ,
            "ZoekMetAdresseerbaarObjectIdentificatie" ;
.

