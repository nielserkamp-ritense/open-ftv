:parameterBSN
    a rdf:Property ;
    skos:prefLabel "Persons API BSN parameter"@en ;
    skos:prefLabel "Personen API BSN parameter"@nl  ;
    dcterms:title "The BSN to be queried"@en ;
    dcterms:title "Het BSN waarnaar gezocht moet worden"@nl ;
    rdf:type rdf:List  ;
    ftv:key "burgerservicenummer" ;
    ftv:value xsd:string ;
