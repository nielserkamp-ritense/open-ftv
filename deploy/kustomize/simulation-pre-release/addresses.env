# The addresses in the demo templates (see demo/addresses.env), as this overlay runs the demo.
# The deploy job fills them in before pushing the manifests.

# Gemeente Vlierdam
VLIERDAM_DATASPACE_URL=http://vlierdam-dataspace
VLIERDAM_PDP1_URL=http://open-ftv-vlierdam-pdp
VLIERDAM_PDP1_INTERNAL_URL=http://open-ftv-vlierdam-pdp:9090
VLIERDAM_PDP2_URL=http://open-ftv-vlierdam-pdp2
VLIERDAM_PDP2_INTERNAL_URL=http://open-ftv-vlierdam-pdp2:9090

# RvIG
RVIG_INWAY_URL=http://brp-inway
RVIG_DATASPACE_URL=http://brp-dataspace
RVIG_PDP1_URL=http://open-ftv-brp-pdp
RVIG_PDP1_INTERNAL_URL=http://open-ftv-brp-pdp:9090

# RDW
RDW_INWAY_URL=http://rdw-inway
RDW_DATASPACE_URL=http://rdw-dataspace
RDW_PDP1_URL=http://open-ftv-rdw-pdp
RDW_PDP1_INTERNAL_URL=http://open-ftv-rdw-pdp:9090
