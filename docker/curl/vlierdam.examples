# Kong gateway

curl -i -X POST 'http://localhost:9002/v1/haalcentraal/api/brp/personen' \
  -H 'Content-Type: application/json' \
  -H 'rvva: 372ddc5d-d093-4272-b485-d7f158775909' \
  -d '{"@filter":"persoon.bsn=999990287","@fields":"bsn,voornamen,geslachtsnaam,adres.*"}'

curl -i 'http://localhost:9002/v1/voertuigen?bsn=999990287' \
  -H 'Content-Type: application/json' \
  -H 'rvva: 372ddc5d-d093-4272-b485-d7f158775909'
