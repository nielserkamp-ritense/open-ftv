# The addresses in the demo templates, as modd.conf and docker/compose.yaml run the demo. The
# Kong gateways run in Docker and reach the host through host.docker.internal; the PDPs and
# managers run on the host. The Simulatieomgeving has its own values in
# deploy/kustomize/<overlay>/addresses.env.

# Gemeente Vlierdam
VLIERDAM_DATASPACE_URL=http://localhost:9010
VLIERDAM_PDP1_URL=http://host.docker.internal:9004
VLIERDAM_PDP1_INTERNAL_URL=http://localhost:9104
VLIERDAM_PDP2_URL=http://host.docker.internal:9005
VLIERDAM_PDP2_INTERNAL_URL=http://localhost:9105

# RvIG
RVIG_INWAY_URL=http://rvig-api-gateway:8000
RVIG_DATASPACE_URL=http://host.docker.internal:9030
RVIG_PDP1_URL=http://host.docker.internal:9024
RVIG_PDP1_INTERNAL_URL=http://localhost:9124

# RDW
RDW_INWAY_URL=http://rdw-api-gateway:8000
RDW_DATASPACE_URL=http://host.docker.internal:9050
RDW_PDP1_URL=http://host.docker.internal:9044
RDW_PDP1_INTERNAL_URL=http://localhost:9144
