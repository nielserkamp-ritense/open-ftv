name: vlierdam3
description: 'Store ID: 01K4CE53QHK137Q03ZDSA1J9CQ'
model: |
  model
    schema 1.1

  type medewerker

  type functie
    relations
      define heeft: [medewerker]

  type gateway
    relations
      define bevragen: [functie#heeft]

  type api
    relations
      define bevragen: [functie#heeft] or bevragen from parent
      define can_read: bevragen and werktijd
      define parent: [gateway]
      define werktijd: [medewerker with werktijd_check]

  condition werktijd_check(nu: timestamp) {
    nu.getDayOfWeek() in [1,2,3,4,5] && nu.getHours() >= 9 && nu.getHours() < 17
  }
tuples:
  - user: medewerker:123
    relation: heeft
    object: functie:laadpaal-aanvragen
    condition: null
  - user: medewerker:21
    relation: heeft
    object: functie:manager
    condition: null
  - user: medewerker:299
    relation: heeft
    object: functie:balie-medewerker
    condition: null
  - user: functie:manager#heeft
    relation: bevragen
    object: gateway:outway
    condition: null
  - user: functie:laadpaal-aanvragen#heeft
    relation: bevragen
    object: api:brp-persoon-op-bsn
    condition: null
  - user: gateway:outway
    relation: parent
    object: api:brp-persoon-op-bsn
    condition: null
tests:
  - name: Tests
    check:
      - user: medewerker:123
        object: functie:laadpaal-aanvragen
        assertions:
          heeft: true
      - user: medewerker:21
        object: functie:manager
        assertions:
          heeft: true
      - user: medewerker:21
        object: functie:laadpaal-aanvragen
        assertions:
          heeft: false
      - user: medewerker:123
        object: api:brp-persoon-op-bsn
        assertions:
          bevragen: true
          werktijd: false
          can_read: false
      - user: medewerker:21
        object: api:brp-persoon-op-bsn
        assertions:
          bevragen: true
          can_read: true
      - user: medewerker:299
        object: api:brp-persoon-op-bsn
        assertions:
          bevragen: false
          can_read: false
